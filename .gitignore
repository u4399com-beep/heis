# ============================================================
# HEIS 小说采集与发布系统 — .gitignore（纯 Go 项目）
# ============================================================

# ── Go 构建产物（go build 输出, 不入版本库） ──
# 主后端 + 11 个 mini-services 二进制, 每个约 10-24MB.
# 源码在 go-backend/*.go 与 go-backend/services/*/main.go, 需时 go build 重新生成.
go-backend/heis-backend
go-backend/qimao-proxy
go-backend/deqixs-proxy
go-backend/fetch-relay
go-backend/scrapling-bridge
go-backend/xjp-proxy
go-backend/uc-bridge
go-backend/bqg713-proxy
go-backend/moli-bridge
go-backend/curl-impersonate-bridge
go-backend/trafilatura-bridge
go-backend/cloak-browser
# 兜底: 未来新增的 services/* 子项目二进制按命名规则自动忽略
go-backend/*-proxy
go-backend/*-bridge
go-backend/*-backend
go-backend/*-browser
go-backend/*-relay
# start-all.sh 构建输出目录
go-backend/bin/
# services/* 子目录默认全忽略, 仅保留源码与脚本
go-backend/services/*/*
!go-backend/services/*/*.go
!go-backend/services/*/go.mod
!go-backend/services/*/go.sum
!go-backend/services/*/scripts/
!go-backend/services/*/.env.example

# ── 运行时日志（heis-backend 后台运行 nohup 输出 + mini-services 日志） ──
*.log
go-backend/*.log
server.log
dev.log
dev.out.log

# ── 环境变量 ──
# .env 含本机 DATABASE_URL 等配置, 不应入库; .env.example 是模板, 显式保留
.env*
!.env.example

# ── 运行时数据（DB + 封面 + TXT 下载产物） ──
db/*.db
db/*.db.lost-*
db/*.db-journal
db/*.db-shm
db/*.db-wal
/data/
backups/
tmp/
# download/ 与 upload/ 为运行时沙箱挂载/产物目录, 不入库 (R50-1C 清理)
download/
upload/
# .tmp/ 为 agent 工作过程临时目录 (R50-1C 清理)
.tmp/

# ── mini-services 运行时 PID/日志 ──
.zscripts/
*.pid

# ── 调试产物（agent 工作过程产物, 不入库） ──
/tool-results/
/skills/tool-results/
/tmp/
/prompt
/test
tmp-shots/
# R57-1C: agent 临时探针脚本 + 源码备份, 防误入库
go-backend/r57probe/
go-backend/*.bak
go-backend/*_tmp_*.go

# ── Python venv 兜底（部分 mini-services 可选 Python 子进程, 防误入库） ──
mini-services/**/.venv/
.venv/
__pycache__/
*.pyc

# ── 系统/编辑器 ──
.DS_Store
*.pem
local-*
.claude
.z-ai-config

# ── Bun 运行时（prisma CLI + @prisma/client 引擎等 JS 工具链依赖, 不入库） ──
# package.json 仅 3 deps (prisma + @prisma/client + z-ai-web-dev-sdk), start-go.js
# 不需 JS 类型, Bun 内置全局可用 (R68-A 删 bun-types 后 243M 体积).
node_modules

# ── R67 路径 bug 产生的错误目录（cd go-backend 后 go build -o go-backend/. 的
#     误用形式会生成 go-backend/go-backend/ 二级嵌套, 防误入库） ──
go-backend/go-backend/
